    <!-- Uninstall protection -->
        <string name="device_admin_label">Ochrona przed odinstalowaniem Acutis Firewall</string>
    <string name="device_admin_description">Blokuje odinstalowanie aplikacji Acutis Firewall, gdy jest ona aktywna. Wyłączenie jej w Ustawieniach powoduje wygenerowanie alertu w Acutis Firewall. Aplikacja Acutis Firewall nie korzysta z żadnych innych funkcji administracji urządzeniem.</string>
    <string name="uninstall_protection">Ochrona przed odinstalowaniem</string>
    <string name="uninstall_protection_summary">Blokuj odinstalowanie tej aplikacji</string>
    <string name="uninstall_protection_explanation">Acutis Firewall wymaga uprawnień administratora urządzenia, aby system Android blokował jej odinstalowanie. Aby ją usunąć, wyłącz tę opcję w Acutis Firewall przy użyciu kodu PIN. Funkcja ta nie zablokuje ekranu, nie zmieni hasła ani nie usunie żadnych danych.</string>
    <string name="uninstall_protection_needs_pin_title">Najpierw ustaw kod PIN</string>
    <string name="uninstall_protection_needs_pin_message">Ochrona przed odinstalowaniem jest odblokowywana kodem PIN rodzica. Ustaw kod PIN przed włączeniem tej funkcji.</string>
    <string name="uninstall_protection_disable_warning">Usunięcie tej opcji pozwoli na odinstalowanie Acutis Firewall, a rodzic zostanie o tym powiadomiony. Aby zrobić to poprawnie, otwórz Acutis Firewall i wprowadź kod PIN rodzica w Ustawieniach.</string>
    <string name="uninstall_protection_gate_title">Zapytaj rodzica</string>
    <string name="uninstall_protection_gate_message">Wprowadź kod PIN rodzica, aby usunąć ochronę przed odinstalowaniem.</string>
    <string name="uninstall_protection_removed_title">Ochrona przed odinstalowaniem została usunięta</string>
    <string name="uninstall_protection_removed_message">Ktoś wyłączył uprawnienia administratora urządzenia dla Acutis Firewall, więc aplikację można teraz odinstalować. Włącz ochronę ponownie, aby zachować blokadę.</string>
    <string name="uninstall_protection_turn_back_on">Włącz ponownie</string>
    <string name="uninstall_protection_unavailable">To urządzenie nie obsługuje ochrony przed odinstalowaniem.</string>
    <string name="uninstall_protection_disable_failed">Nie udało się wyłączyć ochrony przed odinstalowaniem. Usuń ją w Ustawienia &gt; Bezpieczeństwo &gt; Aplikacje administratora urządzenia.</string>
